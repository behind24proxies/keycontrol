# ──────────────────────────────────────────────────────────────────────────────
# KeyControl — Production Environment Variables
#
# Copy this file to .env.production and fill in your values:
#   cp .env.production.example .env.production
#
# Then start the stack:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=keycontrol

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_with_command_above
JWT_EXPIRES_IN=24h

# ── Admin ───────────────────────────────────────────────────────────────────
# Used on first boot to seed the admin password into the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=CHANGE_ME_generate_with_command_above

# ── CORS ────────────────────────────────────────────────────────────────────
# In the unified Docker setup, the dashboard and API share the same domain.
# The server automatically allows requests from its own domain (same-origin).
# You only need to set CORS_ORIGINS if you are querying the API from a 
# DIFFERENT domain. Otherwise, leave it empty or comment it out.
# Example: https://other-gui.example.com
# CORS_ORIGINS=

# ── Ports ───────────────────────────────────────────────────────────────────
# Dashboard port (Nginx — frontend + /api proxy)
DASHBOARD_PORT=80
# Gateway port (direct backend access for external API consumers)
GATEWAY_PORT=3001

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_RETENTION_SECONDS=2592000
LOG_FLUSH_INTERVAL_MS=5000
LOG_MAX_BATCH_SIZE=500

# ── Password Reset (optional) ──────────────────────────────────────────────
# Set only when you need to recover a forgotten admin password.
# RESET_HASH=
