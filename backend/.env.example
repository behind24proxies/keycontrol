# ── Server ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ────────────────────────────────────────────
# PostgreSQL connection URL
# In production, provide the production database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/keycontrol
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5434/keycontrol_test

# ── JWT ─────────────────────────────────────────────────
# REQUIRED in production. In development, a default is used.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ── Bcrypt ──────────────────────────────────────────────
# Number of salt rounds (higher = slower but more secure)
BCRYPT_ROUNDS=12

# ── Email (Resend) ──────────────────────────────────────
# Optional. Leave EMAIL_ENABLED=false to skip sending emails.
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# ── First Admin Bootstrap ───────────────────────────────
# Required to create the very first admin via POST /api/auth/bootstrap-first-admin
FIRST_ADMIN_INVITE_CODE=change-me-secret-code

# ── Frontend URL ────────────────────────────────────────
# Used in invite email links
FRONTEND_URL=http://localhost:3000

# ── Log Retention ───────────────────────────────────────
# How long to keep request logs, in seconds (default: 30 days)
# 2592000 = 60s × 60m × 24h × 30d  (30 days)
LOG_RETENTION_SECONDS=2592000
