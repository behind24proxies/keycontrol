# ── Server ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ────────────────────────────────────────────
# PostgreSQL connection URL
# In production, provide the production database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/keycontrol
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5434/keycontrol_test

# ── JWT ─────────────────────────────────────────────────
# REQUIRED in production. In development, a default is used.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ── Admin Authentication ────────────────────────────────
# REQUIRED in production. Used for admin login.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Password reset hash (leave empty unless resetting)
RESET_HASH=

# ── Frontend URL ────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Log Retention ───────────────────────────────────────
# How long to keep request logs, in seconds (default: 30 days)
# 2592000 = 60s × 60m × 24h × 30d  (30 days)
LOG_RETENTION_SECONDS=2592000

LOG_FLUSH_INTERVAL_MS=5000   # flush every 5 seconds
LOG_MAX_BATCH_SIZE=500       # or when 500 entries accumulate
LOG_MAX_BUFFER_CAP=10000     # Out of Memory (OOM) Prevenetion - max entries held in memory when flushes fail
